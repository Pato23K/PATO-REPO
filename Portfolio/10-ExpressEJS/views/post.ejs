<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <% include('partials/header') %>

    <main>
        <h2><%= post.title %></h2>
        <p><%= post.content %></p>

        <section class="post-actions">
            <form action="/deletePost/<%= postIndex %>" method="POST">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this post?');">Delete Post</button>
            </form>

            <form action="/editPost/<%= postIndex %>" method="POST">
                <label for="content">Edit Content</label>
                <textarea id="content" name="content" required><%= post.content %></textarea>
                <button type="submit">Update Post</button>
            </form>
        </section>
    </main>

    <% include('partials/footer') %>
</body>
</html>
