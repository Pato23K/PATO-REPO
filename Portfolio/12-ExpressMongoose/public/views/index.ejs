<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F1 Drivers</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <h1>Add Driver</h1>
    <form id="driver-form" method="POST" action="/add-driver">
        <label for="num">Number:</label>
        <input type="number" name="num" required>
        <label for="code">Code:</label>
        <input type="text" name="code" required>
        <label for="forename">First Name:</label>
        <input type="text" name="forename" required>
        <label for="surname">Last Name:</label>
        <input type="text" name="surname" required>
        <label for="dob">Date of Birth:</label>
        <input type="date" name="dob" required>
        <label for="nationality">Nationality:</label>
        <input type="text" name="nationality" required>
        <label for="url">URL:</label>
        <input type="url" name="url" required>
        <label for="current_team">Current Team:</label>
        <select name="current_team" id="current_team" required>
            <% teams.forEach(team => { %>
                <option value="<%= team.name %>"><%= team.name %></option>
            <% }); %>
        </select>
        <button type="submit">Add Driver</button>
    </form>

    <h2>Toggle Driver/Team View</h2>
    <button id="toggle-view">Show by Teams</button>

    <h2>List</h2>
    <ul id="list-container">
        <% drivers.forEach(driver => { %>
            <li>
                <span class="driver-info" data-id="<%= driver._id %>">
                    <%= driver.forename %> <%= driver.surname %> (<%= driver.code %>) - <%= driver.current_team %>
                </span>
                <button class="edit-button">Edit</button>
                <button class="save-button" style="display:none;">Save</button>
            </li>
        <% }); %>
    </ul>

    <script>
        let showDrivers = true;

        const fetchDrivers = () => {
            fetch('/drivers')
                .then(response => response.json())
                .then(data => {
                    const listContainer = document.getElementById('list-container');
                    listContainer.innerHTML = ''; // Clear previous entries
                    data.forEach(driver => {
                        const li = document.createElement('li');
                        li.innerHTML = `
                            <span class="driver-info" data-id="${driver._id}">
                                ${driver.forename} ${driver.surname} (${driver.code}) - ${driver.current_team}
                            </span>
                            <button class="edit-button">Edit</button>
                            <button class="save-button" style="display:none;">Save</button>
                        `;
                        listContainer.appendChild(li);
                    });
                });
        };

        const fetchTeams = () => {
            fetch('/teams')
                .then(response => response.json())
                .then(data => {
                    const listContainer = document.getElementById('list-container');
                    listContainer.innerHTML = '';
                    data.forEach(team => {
                        const li = document.createElement('li');
                        li.textContent = team.name;
                        listContainer.appendChild(li);
                    });
                });
        };

        fetchDrivers();

        document.getElementById('toggle-view').addEventListener('click', () => {
            showDrivers = !showDrivers; // Toggle the view
            const buttonText = showDrivers ? 'Show by Teams' : 'Show by Drivers';
            document.getElementById('toggle-view').textContent = buttonText;
            if (showDrivers) {
                fetchDrivers();
            } else {
                fetchTeams();
            }
        });
    </script>
</body>
</html>
